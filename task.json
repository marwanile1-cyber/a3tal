ne-height:1.8;margin:12px 0 0}\n.okd-internal{margin-top:22px;font-size:14px;color:#929aa5}\n.okd-internal a{color:#ffc078!important;border-bottom:1px dashed rgba(255,192,120,.5)}\n.okd-footer-cta{background:linear-gradient(135deg,#ff7a00,#ff9f2f);color:#101216;padding:50px 0}\n.okd-footer-cta .okd-container{display:flex;align-items:center;justify-content:space-between;gap:25px}\n.okd-footer-cta h2{margin:0 0 8px;font-size:36px}.okd-footer-cta p{margin:0;font-weight:700}\n.okd-footer-cta .okd-btn{background:#11151a;color:#fff!important}\n.okd-sticky{display:none}\n@media(max-width:900px){\n .okd-hero{min-height:680px;background-position:62% center}\n .okd-hero-meta,.okd-grid{grid-template-columns:1fr 1fr}\n .okd-split,.okd-contact-box{grid-template-columns:1fr}\n .okd-brands{grid-template-columns:repeat(2,1fr)}\n .okd-b2b{grid-template-columns:1fr}\n .okd-footer-cta .okd-container{display:block}.okd-footer-cta .okd-btn{margin-top:18px}\n}\n@media(max-width:600px){\n .okd-container{width:min(100% - 22px,1180px)}\n .okd-hero{min-height:700px;background-position:68% center}\n .okd-hero-content{padding:62px 0 100px}\n .okd-hero-meta,.okd-grid{grid-template-columns:1fr}\n .okd-section{padding:58px 0}\n .okd-contact-line .okd-btn{width:100%}\n .okd-brands{grid-template-columns:1fr 1fr}\n .okd-sticky{position:fixed;z-index:9999;bottom:8px;left:8px;right:8px;display:grid;grid-template-columns:1fr 1fr;gap:8px;background:rgba(10,12,15,.94);padding:8px;border:1px solid #303640;border-radius:16px;backdrop-filter:blur(10px)}\n .okd-sticky a{padding:12px 8px;border-radius:11px;text-align:center;font-weight:900}\n .okd-sticky .call{background:var(--okd-orange);color:#111}.okd-sticky .wa{background:#1db954;color:#fff}\n}\n</style>\n\n<div class=\"okd-wrap\">\n  <section class=\"okd-hero\">\n    <div class=\"okd-container\">\n      <div class=\"okd-hero-content\">\n        <div class=\"okd-kicker\">Opel Kingdom Desouk • كفر الشيخ – دسوق</div>\n        <h1>مركز <span>Opel Kingdom Desouk</span><br>لصيانة وتشخيص السيارات</h1>\n        <p class=\"okd-lead\">صيانة متكاملة للأفراد والشركات، تشخيص وفحص بالأجهزة، قطع غيار أصلية، خدمات تكييف، فحص شامل قبل البيع والشراء، وتحويل السيارات للعمل بالغاز الطبيعي في مكان واحد.</p>\n        <div class=\"okd-contact-line\">\n          <a class=\"okd-btn okd-btn-orange\" href=\"tel:+201004546026\">اتصال: 01004546026</a>\n          <a class=\"okd-btn okd-btn-green\" href=\"https://wa.me/201004546026\" rel=\"nofollow\">واتساب مباشر</a>\n          <a class=\"okd-btn okd-btn-dark\" href=\"#okd-location\">موقع المركز</a>\n        </div>\n        <div class=\"okd-hero-meta\">\n          <div class=\"okd-mini\"><b>للأفراد والشركات</b><span>صيانة وفحص وخدمة أساطيل مع فواتير ضريبية.</span></div>\n          <div class=\"okd-mini\"><b>تشخيص بالأجهزة</b><span>فحص كمبيوتر شامل قبل استبدال القطع.</span></div>\n          <div class=\"okd-mini\"><b>قطع غيار أصلية</b><span>لأوبل وشيفروليه وMG وستروين وبيجو.</span></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"okd-note\">الصور المستخدمة في الصفحة تصميمات بصرية حصرية للهوية والخدمات وليست توثيقًا فوتوغرافيًا لواجهة المركز الفعلية.</div>\n  </section>\n\n  <section class=\"okd-section\">\n    <div class=\"okd-container\">\n      <div class=\"okd-eyebrow\">مركز واحد • خدمات متكاملة</div>\n      <h2 class=\"okd-title\">كل ما تحتاجه سيارتك <span>تحت سقف واحد</span></h2>\n      <p class=\"okd-copy\">تم تصميم خدمات Opel Kingdom Desouk لتبدأ من التشخيص الصحيح قبل تغيير أي قطعة، ثم تنفيذ الصيانة أو الإصلاح وفق حالة السيارة واحتياج العميل، سواء كانت سيارة فردية أو ضمن أسطول شركة.</p>\n\n      <div class=\"okd-grid\">\n        <div class=\"okd-card\"><div class=\"num\">01</div><h3>صيانة ميكانيكية متكاملة</h3><p>صيانة دورية وإصلاحات ميكانيكية وفحص المحرك والفتيس والعفشة والفرامل ومتابعة الأعطال قبل أن تتحول إلى تكلفة أكبر.</p></div>\n        <div class=\"okd-card\"><div class=\"num\">02</div><h3>كهرباء وتشخيص أعطال</h3><p>قراءة أكواد الأعطال وLive Data وفحص الدوائر والحساسات ومشكلات الشحن والتشغيل بدل الاعتماد على تغيير القطع بالتجربة.</p></div>\n        <div class=\"okd-card\"><div class=\"num\">03</div><h3>فحص شامل قبل البيع والشراء</h3><p>فحص حالة السيارة بالأجهزة مع مراجعة المحرك والفتيس والعفشة والكهرباء والأنظمة الإلكترونية لمساعدة العميل على اتخاذ قرار مبني على حالة فعلية.</p></div>\n        <div class=\"okd-card\"><div class=\"num\">04</div><h3>جميع خدمات التكييف</h3><p>تشخيص ضعف التبريد، فحص الضغوط والتسريب والكمبروسر والمراوح ودائرة الكهرباء، مع إصلاح الأعطال بدل شحن الفريون عشوائيًا.</p></div>\n        <div class=\"okd-card\"><div class=\"num\">05</div><h3>قطع غيار أصلية</h3><p>توفير قطع غيار أصلية من المنصور لعلامات أوبل وشيفروليه وMG وستروين وبيجو، مع مطابقة القطعة للسيارة قبل التركيب.</p></div>\n        <div class=\"okd-card\"><div class=\"num\">06</div><h3>خدمة الشركات والأساطيل</h3><p>صيانة دورية وتشخيص وإصلاح لسيارات الشركات مع إصدار فواتير ضريبية وتنظيم الخدمة بما يناسب التشغيل المستمر للأسطول.</p></div>\n        <div class=\"okd-card\"><div class=\"num\">07</div><h3>تحويل للغاز الطبيعي</h3><p>خدمة تحويل السيارات للعمل بالغاز الطبيعي بالتعاون مع غازتك وفق متطلبات السيارة وإجراءات الفحص المرتبطة بالخدمة.</p></div>\n        <div class=\"okd-card\"><div class=\"num\">08</div><h3>عناية ورفاهية السيارة</h3><p>غسيل كيماوي للمقصورة وتنظيف شامل، بالإضافة إلى غسيل المحركات بالفوم بطريقة تراعي المكونات الكهربائية والحساسات.</p></div>\n        <div class=\"okd-card\"><div class=\"num\">09</div><h3>زيوت كاسترول</h3><p>Opel Kingdom Desouk هو الوكيل الحصري لزيوت كاسترول في محافظة كفر الشيخ، مع اختيار اللزوجة والمواصفة المناسبة للمحرك.</p></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"okd-section alt\">\n    <div class=\"okd-container okd-split\">\n      <div class=\"okd-image\"><img src=\"https://a3tal.com/wp-content/uploads/2026/09/opel-kingdom-desouk-workshop.webp\" alt=\"تصميم حصري لورشة Opel Kingdom Desouk وخدمات الصيانة المتكاملة\" loading=\"lazy\"></div>\n      <div>\n        <div class=\"okd-eyebrow\">الصيانة تبدأ من التشخيص</div>\n        <h2 class=\"okd-title\">مش كل لمبة أعطال معناها <span>غيّر قطعة</span></h2>\n        <p class=\"okd-copy\">الفكرة الأساسية في المركز هي الوصول إلى سبب المشكلة قبل فتح فاتورة قطع غيار بلا داعٍ. لذلك يتم الجمع بين خبرة الفني والفحص العملي وقراءة أجهزة التشخيص، ثم شرح النتيجة للعميل قبل تنفيذ العمل.</p>\n        <ul class=\"okd-list\">\n          <li><strong>فحص مبدئي واضح:</strong> تحديد الأعراض وشروط ظهور العطل قبل بدء الإصلاح.</li>\n          <li><strong>قراءة أكواد وبيانات حية:</strong> استخدام أدوات التشخيص للوصول إلى الدائرة أو النظام المسؤول.</li>\n          <li><strong>اختبار قبل الاستبدال:</strong> قياسات وفحص قدر الإمكان قبل الحكم على القطعة.</li>\n          <li><strong>مراجعة بعد الإصلاح:</strong> التأكد من اختفاء السبب وليس فقط مسح كود العطل.</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"okd-section okd-band\">\n    <div class=\"okd-container\">\n      <div class=\"okd-eyebrow\">قطع الغيار والصيانة</div>\n      <h2 class=\"okd-title\">علامات تجارية <span>نخدمها يوميًا</span></h2>\n      <p class=\"okd-copy\">يتوفر بالمركز قطع غيار أصلية موردة عبر المنصور لعدد من العلامات المنتشرة في السوق المصري، مع خدمات الصيانة والتشخيص المناسبة لكل سيارة.</p>\n      <div class=\"okd-brands\">\n        <div class=\"okd-brand\">OPEL<small>أوبل</small></div>\n        <div class=\"okd-brand\">CHEVROLET<small>شيفروليه</small></div>\n        <div class=\"okd-brand\">MG<small>إم جي</small></div>\n        <div class=\"okd-brand\">CITROËN<small>ستروين</small></div>\n        <div class=\"okd-brand\">PEUGEOT<small>بيجو</small></div>\n      </div>\n      <p class=\"okd-internal\">للمزيد من المعلومات العامة على أعطال.كوم: <a href=\"https://a3tal.com/opel-egypt-service-centers-parts-guide/\">مراكز صيانة أوبل في مصر</a> و <a href=\"https://a3tal.com/%d9%83%d9%84-%d9%85%d8%a7-%d8%aa%d8%ad%d8%aa%d8%a7%d8%ac-%d9%85%d8%b9%d8%b1%d9%81%d8%aa%d9%87-%d8%b9%d9%86-%d9%82%d8%b7%d8%b9-%d8%ba%d9%8a%d8%a7%d8%b1-%d8%a7%d9%88%d8%a8%d9%84-opel-%d8%a7%d9%84/\">دليل قطع غيار أوبل</a>.</p>\n    </div>\n  </section>\n\n  <section class=\"okd-section alt\">\n    <div class=\"okd-container okd-split\">\n      <div>\n        <div class=\"okd-eyebrow\">فحص شامل قبل البيع والشراء</div>\n        <h2 class=\"okd-title\">اعرف حالة العربية <span>قبل ما تدفع</span></h2>\n        <p class=\"okd-copy\">خدمة الفحص قبل الشراء مصممة لمن يريد معرفة حالة السيارة بقدر أكبر من الوضوح قبل إتمام الصفقة. يتم فحص الأنظمة المتاحة بالأجهزة إلى جانب التقييم الميكانيكي والكهربائي، مع التركيز على الأعطال الحالية والإشارات التي تستحق مراجعة أعمق.</p>\n        <ul class=\"okd-list\">\n          <li>فحص كمبيوتر وقراءة أكواد الأعطال ووحدات السيارة المتاحة.</li>\n          <li>تقييم المحرك والفتيس والعفشة والفرامل والكهرباء.</li>\n          <li>مراجعة أنظمة الراحة والتكييف والحساسات حسب تجهيز السيارة.</li>\n          <li>شرح الملاحظات للعميل قبل اتخاذ قرار الشراء أو البيع.</li>\n        </ul>\n      </div>\n      <div class=\"okd-image\"><img src=\"https://a3tal.com/wp-content/uploads/2026/09/opel-kingdom-desouk-diagnostics.webp\" alt=\"فني يستخدم جهاز تشخيص وفحص كمبيوتر داخل مركز Opel Kingdom Desouk\" loading=\"lazy\"></div>\n    </div>\n  </section>\n\n  <section class=\"okd-section\">\n    <div class=\"okd-container\">\n      <div class=\"okd-highlight\">\n        <div class=\"okd-eyebrow\">كاسترول في كفر الشيخ</div>\n        <h3>الوكيل الحصري لزيوت <span>Castrol</span> في محافظة كفر الشيخ</h3>\n        <p class=\"okd-copy\">اختيار الزيت لا يعتمد على اسم العلامة وحده. يتم تحديد اللزوجة والمواصفة المناسبة حسب المحرك ومتطلبات الشركة المصنعة وظروف التشغيل، مع توفير زيوت كاسترول من خلال المركز.</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"okd-section alt\">\n    <div class=\"okd-container okd-split\">\n      <div class=\"okd-image\"><img src=\"https://a3tal.com/wp-content/uploads/2026/09/opel-kingdom-desouk-gastec-cng.webp\" alt=\"تصميم حصري لخدمة تحويل السيارات للعمل بالغاز الطبيعي بالتعاون مع غازتك\" loading=\"lazy\"></div>\n      <div>\n        <div class=\"okd-eyebrow\">خدمة اقتصادية للسيارات المناسبة</div>\n        <h2 class=\"okd-title\">تحويل السيارات للعمل بالغاز الطبيعي <span>بالتعاون مع غازتك</span></h2>\n        <p class=\"okd-copy\">يوفر المركز خدمة تحويل السيارات للعمل بالغاز الطبيعي بالتعاون مع شركة غازتك، مع فحص السيارة وتحديد مدى ملاءمتها للتحويل والإجراءات المطلوبة قبل التنفيذ.</p>\n        <p class=\"okd-copy\" style=\"margin-top:14px\">التحويل قرار اقتصادي وتشغيلي، لذلك يتم تقييم حالة المحرك واستخدام السيارة أولًا، خصوصًا للسيارات التي تعمل لمسافات يومية كبيرة أو ضمن أساطيل الشركات.</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"okd-section\">\n    <div class=\"okd-container\">\n      <div class=\"okd-eyebrow\">للأفراد والشركات</div>\n      <h2 class=\"okd-title\">خدمة مرنة <span>وفواتير ضريبية</span></h2>\n      <div class=\"okd-b2b\">\n        <div><h3>للأفراد</h3><p>من الصيانة الدورية وحتى الأعطال المعقدة، يمكن تنفيذ الخدمة المطلوبة مع توضيح الملاحظات قبل بدء الإصلاح، ومتابعة حالة السيارة بعد التنفيذ.</p></div>\n        <div><h3>للشركات والأساطيل</h3><p>خدمة سيارات الشركات مع صيانة وتشخيص وإصلاح وفواتير ضريبية، بما يساعد على تنظيم تكلفة تشغيل الأسطول وتقليل فترات توقف السيارات.</p></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"okd-section alt\">\n    <div class=\"okd-container\">\n      <div class=\"okd-eyebrow\">التكييف والعناية بالسيارة</div>\n      <h2 class=\"okd-title\">من التبريد إلى <span>التنظيف العميق</span></h2>\n      <div class=\"okd-grid\">\n        <div class=\"okd-card\"><h3>فحص وإصلاح التكييف</h3><p>اختبار أداء الدائرة والضغوط والتسريب والكمبروسر والمراوح والكهرباء لتحديد سبب ضعف التبريد.</p></div>\n        <div class=\"okd-card\"><h3>غسيل كيماوي</h3><p>تنظيف عميق للمقصورة والخامات الداخلية مع الاهتمام بالمناطق التي تجمع الأتربة والروائح.</p></div>\n        <div class=\"okd-card\"><h3>غسيل المحركات بالفوم</h3><p>تنظيف حجرة المحرك بالفوم مع مراعاة المكونات الإلكترونية والفيش والحساسات بدل الرش العشوائي للمياه.</p></div>\n      </div>\n      <p class=\"okd-internal\">لو بتدور على معلومات تشخيصية قبل زيارة المركز، راجع دليل <a href=\"https://a3tal.com/car-ac-water-inside-cabin-drain/\">مياه التكييف داخل السيارة وخرطوم الصرف</a> أو <a href=\"https://a3tal.com/automatic-transmission-fluid-change-guide-risks/\">دليل تغيير زيت الفتيس الأوتوماتيك</a>.</p>\n    </div>\n  </section>\n\n  <section class=\"okd-section\" id=\"okd-location\">\n    <div class=\"okd-container\">\n      <div class=\"okd-contact-box\">\n        <div class=\"okd-contact-info\">\n          <div class=\"okd-eyebrow\">زورنا أو تواصل معنا</div>\n          <h2>Opel Kingdom <span>Desouk</span></h2>\n          <div class=\"okd-contact-item\"><b>العنوان:</b><br>محافظة كفر الشيخ – مركز دسوق – شارع الجيش – بجوار مستشفى الزهراء</div>\n          <div class=\"okd-contact-item\"><b>اتصال وواتساب:</b><br><a href=\"tel:+201004546026\" style=\"color:#ffc078\">01004546026</a> &nbsp;•&nbsp; <a href=\"tel:+201558881388\" style=\"color:#ffc078\">01558881388</a></div>\n          <div class=\"okd-contact-line\">\n            <a class=\"okd-btn okd-btn-orange\" href=\"tel:+201004546026\">اتصل الآن</a>\n            <a class=\"okd-btn okd-btn-green\" href=\"https://wa.me/201004546026\" rel=\"nofollow\">واتساب 01004546026</a>\n            <a class=\"okd-btn okd-btn-green\" href=\"https://wa.me/201558881388\" rel=\"nofollow\">واتساب 01558881388</a>\n          </div>\n        </div>\n        <div class=\"okd-map\">\n          <iframe loading=\"lazy\" allowfullscreen referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://www.google.com/maps?q=Opel%20Kingdom%20Desouk%20%D8%AF%D8%B3%D9%88%D9%82%20%D8%B4%D8%A7%D8%B1%D8%B9%20%D8%A7%D9%84%D8%AC%D9%8A%D8%B4%20%D8%A8%D8%AC%D9%88%D8%A7%D8%B1%20%D9%85%D8%B3%D8%AA%D8%B4%D9%81%D9%89%20%D8%A7%D9%84%D8%B2%D9%87%D8%B1%D8%A7%D8%A1&output=embed\"></iframe>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"okd-section alt\">\n    <div class=\"okd-container\">\n      <div class=\"okd-eyebrow\">أسئلة سريعة</div>\n      <h2 class=\"okd-title\">قبل ما تزور <span>المركز</span></h2>\n      <div class=\"okd-faq\">\n        <details><summary>هل المركز يخدم أوبل فقط؟</summary><p>لا. المركز متخصص بقوة في أوبل، ويقدم كذلك خدمات وقطع غيار لسيارات شيفروليه وMG وستروين وبيجو، إلى جانب صيانة وتشخيص سيارات أخرى حسب نوع الخدمة والحالة.</p></details>\n        <details><summary>هل يوجد فحص شامل قبل شراء سيارة مستعملة؟</summary><p>نعم، تتوفر خدمة فحص شامل قبل البيع والشراء تشمل الفحص بالأجهزة إلى جانب التقييم الميكانيكي والكهربائي للأنظمة الرئيسية بالسيارة.</p></details>\n        <details><summary>هل المركز يتعامل مع الشركات؟</summary><p>نعم، توجد خدمات صيانة للأفراد والشركات والأساطيل، مع إمكانية إصدار فواتير ضريبية للخدمات المقدمة.</p></details>\n        <details><summary>هل توجد قطع غيار أصلية؟</summary><p>بحسب خدمات المركز، تتوفر قطع غيار أصلية من المنصور لعلامات أوبل وشيفروليه وMG وستروين وبيجو، ويتم اختيار القطعة المناسبة حسب السيارة ورقمها ومواصفاتها.</p></details>\n        <details><summary>هل يوجد تحويل للغاز الطبيعي؟</summary><p>نعم، يقدم المركز خدمة تحويل السيارات للعمل بالغاز الطبيعي بالتعاون مع غازتك بعد مراجعة مدى ملاءمة السيارة للتحويل.</p></details>\n        <details><summary>هل يوجد واتساب للحجز والاستفسار؟</summary><p>نعم، يمكن التواصل عبر واتساب أو الاتصال على 01004546026 أو 01558881388.</p></details>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"okd-footer-cta\">\n    <div class=\"okd-container\">\n      <div><h2>سيارتك محتاجة فحص أو صيانة؟</h2><p>تواصل مع Opel Kingdom Desouk وحدد الخدمة قبل زيارة المركز.</p></div>\n      <div class=\"okd-contact-line\">\n        <a class=\"okd-btn\" href=\"tel:+201004546026\">01004546026</a>\n        <a class=\"okd-btn\" href=\"tel:+201558881388\">01558881388</a>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"okd-sticky\">\n    <a class=\"call\" href=\"tel:+201004546026\">اتصال مباشر</a>\n    <a class=\"wa\" href=\"https://wa.me/201004546026\" rel=\"nofollow\">واتساب</a>\n  </div>\n</div>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\":\"https://schema.org\",\n  \"@type\":\"AutoRepair\",\n  \"name\":\"Opel Kingdom Desouk\",\n  \"url\":\"https://a3tal.com/opel-kingdom-desouk/\",\n  \"image\":\"https://a3tal.com/wp-content/uploads/2026/09/opel-kingdom-desouk-exterior.webp\",\n  \"telephone\":\"+201004546026\",\n  \"address\":{\n    \"@type\":\"PostalAddress\",\n    \"streetAddress\":\"شارع الجيش بجوار مستشفى الزهراء\",\n    \"addressLocality\":\"دسوق\",\n    \"addressRegion\":\"كفر الشيخ\",\n    \"addressCountry\":\"EG\"\n  },\n  \"areaServed\":[\"دسوق\",\"كفر الشيخ\"],\n  \"contactPoint\":[\n    {\"@type\":\"ContactPoint\",\"telephone\":\"+201004546026\",\"contactType\":\"customer service\"},\n    {\"@type\":\"ContactPoint\",\"telephone\":\"+201558881388\",\"contactType\":\"customer service\"}\n  ],\n  \"hasOfferCatalog\":{\n    \"@type\":\"OfferCatalog\",\n    \"name\":\"خدمات Opel Kingdom Desouk\",\n    \"itemListElement\":[\n      {\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"صيانة ميكانيكية وكهربائية للسيارات\"}},\n      {\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"فحص وتشخيص السيارات بالأجهزة\"}},\n      {\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"فحص شامل قبل البيع والشراء\"}},\n      {\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"صيانة وإصلاح تكييف السيارات\"}},\n      {\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"تحويل السيارات للعمل بالغاز الطبيعي\"}},\n      {\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"غسيل كيماوي وغسيل محركات بالفوم\"}}\n    ]\n  }\n}\n</script>\n",
