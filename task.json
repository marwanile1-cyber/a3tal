one'=>$phone?:null,\n    'email'=>$email?:null,\n    'address'=>[\n      '@type'=>'PostalAddress',\n      'streetAddress'=>$address,\n      'addressCountry'=>'EG'\n    ],\n    'hasMap'=>$map_url?:null,\n    'sameAs'=>$source?[$source]:[],\n    'image'=>has_post_thumbnail()?get_the_post_thumbnail_url(get_the_ID(),'full'):null,\n  ];\n  $schema=array_filter($schema,static fn($v)=>$v!==null&&$v!==''&&$v!==[]);\n?>\n<script type=\"application/ld+json\"><?php echo wp_json_encode($schema,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES); ?></script>\n<?php endif; ?>\n\n</main><?php endwhile;get_footer(); ?>","confirm":true,"dangerous":true}},{"method":"POST","path":"/admin","body":{"op":"cache_flush"}}]}