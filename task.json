        "content": "\n<style>\n.page-id-82702 .entry-title,.page-id-82702 .page-title,.page-id-82702 .post-title{display:none!important}\n.page-id-82702 .entry-content{margin:0!important;max-width:none!important}\n.okd-wrap{--okd-orange:#ff7a00;--okd-orange2:#ff9d2e;--okd-bg:#090b0e;--okd-card:#11151a;--okd-line:#272c33;--okd-text:#f7f8fa;--okd-muted:#aeb6c2;direction:rtl;background:var(--okd-bg);color:var(--okd-text);font-family:inherit;width:100vw;margin-inline:calc(50% - 50vw);overflow:hidden}\n.okd-wrap *{box-sizing:border-box}\n.okd-wrap a{text-decoration:none}\n.okd-container{width:min(1180px,calc(100% - 32px));margin:auto}\n.okd-hero{min-height:720px;display:flex;align-items:center;position:relative;background:\nlinear-gradient(90deg,rgba(5,7,10,.97) 0%,rgba(5,7,10,.88) 38%,rgba(5,7,10,.28) 72%,rgba(5,7,10,.12) 100%),\nurl('https://a3tal.com/wp-content/uploads/2026/09/opel-kingdom-desouk-exterior.webp') center/cover no-repeat}\n.okd-hero:after{content:\"\";position:absolute;inset:auto 0 0;height:180px;background:linear-gradient(transparent,var(--okd-bg))}\n.okd-hero-content{position:relative;z-index:2;max-width:700px;padding:80px 0}\n.okd-kicker{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,122,0,.4);background:rgba(255,122,0,.1);color:#ffc27b;border-radius:999px;padding:9px 16px;font-size:14px;font-weight:800;margin-bottom:18px}\n.okd-hero h1{font-size:clamp(38px,6vw,72px);line-height:1.08;margin:0 0 18px;color:#fff;letter-spacing:-1px}\n.okd-hero h1 span{color:var(--okd-orange)}\n.okd-lead{font-size:clamp(18px,2.2vw,24px);line-height:1.8;color:#e7e9ed;max-width:660px;margin:0 0 25px}\n.okd-contact-line{display:flex;flex-wrap:wrap;gap:11px;margin:26px 0}\n.okd-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:14px 21px;border-radius:13px;font-weight:900;transition:.2s;border:1px solid transparent}\n.okd-btn:hover{transform:translateY(-2px)}\n.okd-btn-orange{background:linear-gradient(135deg,var(--okd